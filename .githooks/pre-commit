#!/usr/bin/env bash
# Tool-agnostic gate (Claude, Codex, humans): a commit needs a current context ack for the purpose docs.
# Run once per session: bash scripts/context-ack.sh --session <label> --who <name>
# Bypassable with --no-verify (the Claude hook blocks that flag; CI is the hard check).
root=$(git rev-parse --show-toplevel)
# Public repo (ADR 0003): scan staged changes for secrets when gitleaks is installed.
if command -v gitleaks >/dev/null 2>&1; then
  # --exit-code 3 separates a finding (3) from a usage or runtime error (1, e.g. an unknown flag).
  gitleaks protect --staged --redact --no-banner --log-level warn --exit-code 3
  rc=$?
  if [[ $rc -eq 3 ]]; then
    echo "Commit refused: gitleaks found a secret-like string in the staged changes." >&2; exit 1
  elif [[ $rc -ne 0 ]]; then
    echo "Commit refused: gitleaks failed to run (exit $rc); check the version with 'gitleaks version' (tested with 8.30.1)." >&2; exit 1
  fi
else
  echo "warning: gitleaks not installed; the repo is public, install it (see docs/public-release.md)." >&2
fi
[[ -x "$root/scripts/context-ack.sh" ]] || exit 0
if bash "$root/scripts/context-ack.sh" --check --any; then exit 0; fi
cat >&2 <<'MSG'
Commit refused: no current context acknowledgement.
Run: bash scripts/context-ack.sh --session <label> --who <isabel|fernando|lorenz|helmut>
Read the files it lists, then commit again. (The ack expires when AGENTS.md, ideas/decision.md or diseno/decisions.md change.)
MSG
exit 1
