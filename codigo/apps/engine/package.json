  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shelfie engine: jobs, tasks, claims, submissions, payouts, ledger, REST + SSE API.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
