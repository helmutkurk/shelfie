    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@shelfie/core": "0.0.0",
    "@shelfie/domain-shelf": "0.0.0",
    "@shelfie/evidence": "0.0.0",
    "@shelfie/payments": "0.0.0",
    "express": "4.22.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "tsx": "4.21.0"
  }
}
