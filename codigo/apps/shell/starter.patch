+// On Windows the npm shim is sokosumi.cmd, which execFileSync cannot start without a shell; run the package's JS entry with node instead.
+export function execSokosumi(command,args,options){
+ if(process.platform!=='win32')return execFileSync(command,args,options);
+ const shim=execFileSync('where.exe',[`${command}.cmd`],{encoding:'utf8'}).split(/\r?\n/)[0].trim();
+ return execFileSync(process.execPath,[join(dirname(shim),'node_modules','@masumi_network','sokosumi','dist','bin','sokosumi.js'),...args],options);
+}
+export function sokosumiRoot(run=execSokosumi){
+ const skillsPath=run('sokosumi',['skills','path'],{encoding:'utf8',timeout:30000}).trim().replace(/[\\/]+$/,'');
+ if(!isAbsolute(skillsPath)||basename(skillsPath)!=='skills')throw new Error('sokosumi skills path returned an invalid package path');
