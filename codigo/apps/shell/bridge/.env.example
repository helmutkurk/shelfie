# Names only, no values. Our additions to the starter's .env (contracts.md section 5.4).
# Never commit the real file. The starter's own names (COWORKER_ID, EVE_PORT, PAID_TASKS_ENABLED,
# ZAI_*, MPS_URL, AGENT_API_PORT, AGENT_AUTHOR, SOKOSUMI_ORGANIZATION_ID, ...) stay in its .env.example.

# Engine base URL (default http://127.0.0.1:4000)
ENGINE_URL=
# Secret for the X-Shell-Token header; must equal the engine's SHELL_TOKEN.
# Setting it also switches the patched starter's answer() from the model to the bridge.
SHELL_TOKEN=
# Long-poll waitSec for GET /api/jobs/{id}/decision, 0 to 60 (default 20)
SHELL_DECISION_POLL_SEC=
# Seconds kept free before the Masumi submit deadline to hash and submit a DELIVER result (default 300)
SHELL_DEADLINE_MARGIN_SEC=
# Domain pack id (default shelf-check)
PACK_ID=
# Optional: windowSec sent with POST /api/jobs (600 on the hub); the bridge lowers it when the lock
# came late, so the window ends before deadline - SHELL_DEADLINE_MARGIN_SEC - 30 s
JOB_WINDOW_SEC=
