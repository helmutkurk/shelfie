# apps/web build-time names (public by design; never put a secret in a VITE_ variable).
# Source: diseno/contracts.md section 5.5. Names only, no values.
# Empty = same origin as the engine (the normal case).
VITE_API_BASE=
# 1 shows demo badges (override, fake payments) even before /api/config answers
VITE_DEMO_BADGES=
# Dev server only (vite.config.ts reads it, the browser bundle never does).
# Not in contracts.md yet: engine URL for the /api proxy, default http://127.0.0.1:4000
VITE_ENGINE_URL=
