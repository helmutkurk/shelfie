# Shelfie env names (names only, NO values). Source: diseno/contracts.md section 5.
# Copy to .env (untracked) and fill in locally. Wallets are throwaway, preprod only.
# Fake mode needs none of the secrets: FAKE_PAYMENTS=1, VERIFIER_PAYMENT=off, VERIFIER_MODE=stub.

# ---------------------------------------------------------------- 5.1 Shared
# development | test | production
NODE_ENV=
# Always "preprod"; any other value is refused at startup (mainnet guard in @shelfie/core)
NETWORK=
# debug | info | warn | error
LOG_LEVEL=
# Domain pack id, "shelf-check"
PACK_ID=
# Secret for X-Admin-Token on admin endpoints (engine and verifier)
ADMIN_TOKEN=
# Explorer base for transaction links (default https://preprod.cardanoscan.io/transaction/)
EXPLORER_TX_BASE=
# Explorer base for address links
EXPLORER_ADDRESS_BASE=

# ---------------------------------------------------------------- 5.2 Engine
# Engine HTTP port (default 4000)
ENGINE_PORT=
# Public URL of the engine behind the tunnel (QR code, links)
PUBLIC_BASE_URL=
# Default store geofence radius in metres (150)
DEFAULT_GEOFENCE_M=
# Cap on the GPS accuracy added to the geofence radius, metres (100)
ACCURACY_CAP_M=
# Failed capture-time location prechecks before the claim is released (3)
LOCATION_MAX_TRIES=
# Allow captureMode admin-test with X-Admin-Token (false; must be false in evidence runs)
ALLOW_TEST_UPLOAD=
# Secret for X-Shell-Token (shell bridge -> engine)
SHELL_TOKEN=
# Secret the engine sends as X-Engine-Token to the verifier
ENGINE_TOKEN=
# Base URL of the verifier, for example http://127.0.0.1:4021
VERIFIER_URL=
# on = pay the verifier through x402; off = call /v1/verify-dry (dev)
VERIFIER_PAYMENT=
# 1 = fake payment adapters (no wallets, red banner in the UI)
FAKE_PAYMENTS=
# Job window in seconds (900); must end before the Masumi submit deadline
JOB_WINDOW_SEC=
# Claim time to live in seconds (300)
CLAIM_TTL_SEC=
# Time reserved for one serialised verify in seconds (120)
VERIFY_BUDGET_SEC=
# on | off; off disables the location precheck (rehearsal only, ledger-flagged)
LOCATION_CHECK=
# Override the pack challenge mode: gesture (pack default) | card-pool | handwritten (ADR-19)
CHALLENGE_MODE=
# Max verify attempts per task
MAX_ATTEMPTS=
# Max decoded image size in bytes (2000000)
MAX_IMAGE_BYTES=
# Worker payout in lovelace, integer string (3000000)
PAYOUT_LOVELACE=
# Max send attempts per payout before FAILED_FINAL
PAYOUT_MAX_ATTEMPTS=
# Number of payout wallets (names only, one mnemonic variable per wallet)
PAYOUT_WALLETS=
# Number of verify-buyer wallets
VBUY_WALLETS=
# Dashboard red banner when a wallet balance is below this, lovelace
MIN_WALLET_LOVELACE=
# Allow the flagged demo override endpoint (false; must be false in evidence runs)
ALLOW_DEMO_OVERRIDE=
# Path of the engine event log (JSONL, untracked)
STORE_PATH=
# Path of the hash-chained evidence ledger (JSONL, untracked, never reset)
LEDGER_PATH=
# Blockfrost project id for preprod (secret)
BLOCKFROST_PROJECT_ID=
# Mnemonic of payout wallet 1 (secret, only packages/payments reads it)
PAY_MNEMONIC_1=
# Mnemonic of payout wallet 2 (secret)
PAY_MNEMONIC_2=
# Mnemonic of verify-buyer wallet 1 (secret)
VBUY_MNEMONIC_1=
# Mnemonic of verify-buyer wallet 2 (secret)
VBUY_MNEMONIC_2=
# Spend cap per x402 payment, lovelace (2000000)
VERIFY_MAX_PRICE_LOVELACE=
# Total x402 verify spend per engine run, lovelace (50000000); must be >= VERIFY_MAX_PRICE_LOVELACE
VERIFY_RUN_CAP_LOVELACE=
# x402 facilitator URL (verify Friday)
FACILITATOR_URL=

# ---------------------------------------------------------------- 5.3 Verifier
# Verifier HTTP port (default 4021)
VERIFIER_PORT=
# W-SELL address that receives verify fees (public address, not a secret)
SELLER_ADDRESS=
# (FACILITATOR_URL and BLOCKFROST_PROJECT_ID are listed above; the verifier reads them too)
# Price per check in lovelace (1000000)
VERIFY_PRICE_LOVELACE=
# Vision provider id (an OpenAI-compatible adapter serves Gemini and OpenAI)
VISION_PROVIDER=
# Vision model id (verify Friday, do not hard-code)
VISION_MODEL=
# Vision API base URL
VISION_BASE_URL=
# Vision API key (secret)
VISION_API_KEY=
# Fallback vision API base URL
VISION_FALLBACK_BASE_URL=
# Fallback vision model id
VISION_FALLBACK_MODEL=
# Fallback vision API key (secret)
VISION_FALLBACK_API_KEY=
# Vision call timeout in ms
VISION_TIMEOUT_MS=
# Vision max output tokens
VISION_MAX_TOKENS=
# stub = canned extractions, no vision call; live = real vision (not in contracts section 5; repo-layout section 3)
VERIFIER_MODE=
# Enable POST /v1/verify-dry and /v1/extract without payment (false outside dev)
ENABLE_DRY=
# Path of the idempotency cache file
IDEMPOTENCY_CACHE_PATH=
# Idempotency cache TTL in seconds (longer than the job window)
IDEMPOTENCY_TTL_SEC=
# true = require the X-Engine-Token header on /v1/verify
X_ENGINE_TOKEN_REQUIRED=
# (ENGINE_TOKEN is listed above; the verifier compares the header against it)

# ---------------------------------------------------------------- 5.4 Shell
# Starter/Masumi names (from the starter and runbook)
COWORKER_ID=
EVE_PORT=
EVE_URL=
PAID_TASKS_ENABLED=
ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_MODEL=
ZAI_CONTEXT_WINDOW_TOKENS=
MPS_URL=
AGENT_API_PORT=
AGENT_AUTHOR=
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=
# Masumi Payment Service side (its own env file, listed for completeness)
DATABASE_URL=
ENCRYPTION_KEY=
ADMIN_KEY=
BLOCKFROST_API_KEY_PREPROD=
PORT=
# Ours: engine base URL for the shell bridge, for example http://127.0.0.1:4000
ENGINE_URL=
# (SHELL_TOKEN is listed above; the bridge sends it as X-Shell-Token)
# Long-poll wait per decision request in seconds (25)
SHELL_DECISION_POLL_SEC=
# Time kept after the window to hash and submit a result in seconds (300)
SHELL_DEADLINE_MARGIN_SEC=

# ---------------------------------------------------------------- 5.5 Web (build time)
# API base URL; empty for same origin
VITE_API_BASE=
# Show demo badges (fake payments, override) in the UI
VITE_DEMO_BADGES=

# ---------------------------------------------------------------- 5.6 Hub scripts
# Tunnel provider name
TUNNEL_PROVIDER=
# File the tunnel script writes the public URL to
TUNNEL_URL_FILE=
# LAN IP of the hub laptop
HUB_LAN_IP=

# Integration switches (see contracts section 5)
VISION_RUN_CAP=
PAYOUT_DAILY_CAP_LOVELACE=
ALLOWED_HOSTS=
# Exact extra browser origins allowed on POST (comma-separated, no wildcards), e.g. the Vercel frontend
ALLOWED_ORIGINS=
CATALOG_DIR=
WEB_DIST=
VERIFY_CLIENT=
PAYMENTS_IMPL=
PAYOUT_STORE_PATH=
EVIDENCE_RUN_LOCKED=
VITE_ENGINE_URL=
WALLET_ADDRESS_VBUY=
WALLET_ADDRESS_PAY=
WALLET_ADDRESS_MPS=

# ADR-20: engine only; never set as VITE_ variables
SOKOSUMI_CLIENT=
SOKOSUMI_API_URL=
SOKOSUMI_API_TOKEN=
SOKOSUMI_AGENT_ID=
SOKOSUMI_MAX_CREDITS_PER_TASK=
ORDER_MAX_STORES=
ORDER_DAILY_CREDIT_CAP=
BRAND_TOKEN=
