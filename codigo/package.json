{
  "name": "shelfie",
  "license": "BUSL-1.1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shelfie monorepo: verified shelf checks, paid only when the photo is true (Cardano preprod).",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "eval"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run && node --test apps/shell/bridge/*.test.js",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "tsx scripts/smoke.ts",
    "hub-up": "bash scripts/hub-up.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@x402/core": {
      "zod": "4.6.7"
    },
    "@x402/extensions": {
      "zod": "4.6.7"
    }
  }
}
