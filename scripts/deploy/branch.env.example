# Names and placeholders only. Copy to ~/.config/shelfie/<branch>.env (chmod 600), outside the repo.
# Loaded by systemd EnvironmentFile= (plain KEY=value, no quotes, no `export`, no variable expansion).
# main: ports 4000/4021, https://api.shelfieapp.fyi.  dev: ports 4100/4121, https://api-dev.shelfieapp.fyi.
NODE_ENV=production
ENGINE_PORT=4000
VERIFIER_PORT=4021
VERIFIER_URL=http://127.0.0.1:4021
PUBLIC_BASE_URL=https://api.shelfieapp.fyi
# Exact origins of the Vercel frontend (no wildcards): main -> https://app.shelfieapp.fyi, dev -> https://dev.shelfieapp.fyi
ALLOWED_ORIGINS=https://app.shelfieapp.fyi
# Extra Host names when the engine is also reached under another name
ALLOWED_HOSTS=
# Keep data outside the release directories (they are replaced on every deploy)
STORE_PATH=/home/USER/.local/share/shelfie/main/engine-events.jsonl
LEDGER_PATH=/home/USER/.local/share/shelfie/main/evidence-ledger.jsonl
PAYOUT_STORE_PATH=/home/USER/.local/share/shelfie/main/payout-queue.json
LOCATION_CHECK=on
# Test deployments run on fakes until the real switches are authorised (README "Fake and real switches"):
FAKE_PAYMENTS=1
VERIFIER_PAYMENT=off
VERIFIER_MODE=stub
# Secrets: fill locally, 32+ random bytes each, different values, never in git:
ADMIN_TOKEN=
SHELL_TOKEN=
ENGINE_TOKEN=
